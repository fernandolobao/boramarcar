{
  "name": "@boramarcar/core",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Regras de domínio puras (sem I/O de banco) compartilhadas entre web e, no futuro, mobile.",
  "exports": {
    ".": "./src/index.ts",
    "./availability": "./src/availability/index.ts",
    "./ranking": "./src/ranking/index.ts",
    "./decks": "./src/decks/index.ts",
    "./analysis": "./src/analysis/index.ts",
    "./errors": "./src/errors/index.ts",
    "./time": "./src/time/index.ts",
    "./calendar": "./src/calendar/index.ts",
    "./email": "./src/email/index.ts",
    "./games": "./src/games/index.ts",
    "./stats": "./src/stats/index.ts",
    "./achievements": "./src/achievements/index.ts",
    "./currency": "./src/currency/index.ts",
    "./places": "./src/places/index.ts",
    "./table": "./src/table/index.ts",
    "./push": "./src/push/index.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit && tsc --noEmit -p contract",
    "test": "vitest run",
    "test:contract": "vitest run --config vitest.contract.config.ts"
  },
  "dependencies": {
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "typescript": "~6.0.3",
    "vitest": "5.1.0",
    "@types/node": "^22.19.0"
  }
}
