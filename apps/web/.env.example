# Postgres (Neon em produção — use a URL "pooled"; Docker local: veja docker-compose.yml)
DATABASE_URL=postgres://boramarcar:boramarcar@localhost:5432/boramarcar

# Better Auth — gere com: openssl rand -base64 32
BETTER_AUTH_SECRET=troque-por-um-segredo-com-32-caracteres-ou-mais
# URL pública do app (em produção: https://www.arcanakin.com.br)
BETTER_AUTH_URL=http://localhost:3000

# Google OAuth — https://console.cloud.google.com/apis/credentials
# URI de redirecionamento autorizado: {BETTER_AUTH_URL}/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# E-mails (Resend — https://resend.com/api-keys). Opcional: sem a chave, os avisos só vão para o log.
# Sem domínio verificado, o Resend só entrega para o e-mail dono da conta.
RESEND_API_KEY=
# EMAIL_FROM="ArcanaKin <avisos@seu-dominio.com>"

# Segredo dos cron jobs (lembretes diários). Gere com: openssl rand -base64 32
CRON_SECRET=

# Sentry (erros do site). Opcional: sem o DSN, nada é enviado. O DSN é público (vai no navegador).
# NEXT_PUBLIC_SENTRY_DSN=
# Só para subir os mapas de código no build (Vercel): token de organização do Sentry.
# SENTRY_ORG=
# SENTRY_PROJECT=
# SENTRY_AUTH_TOKEN=
